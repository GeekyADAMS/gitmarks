# Self-hosted: both are required in production. `pnpm secret` prints a good GITMARKS_SECRET.

# Your password for the page, and the key that signs sessions and device keys.
# At least 24 characters.
GITMARKS_SECRET=""

# Fine-grained GitHub token: this repository only, Contents: read and write.
# Leave empty locally to keep bookmarks in .gitmarks-local.json instead.
GITHUB_TOKEN=""

# Optional. On Vercel both are read from the deployment itself.
# GITMARKS_REPO="you/gitmarks"
# GITMARKS_BRANCH="main"

# Hosted mode (one gitmarks for everyone, like gitmarks.a9m.pro). Setting all four
# switches it on; `pnpm github-app https://your-domain` makes them for you.
# GITHUB_APP_CLIENT_ID=""
# GITHUB_APP_CLIENT_SECRET=""
# GITHUB_APP_SLUG=""
# GITHUB_APP_PRIVATE_KEY=""
