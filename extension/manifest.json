{
  "manifest_version": 3,
  "name": "gitmarks",
  "description": "Save the current page, any link, or any post on X into your own gitmarks.",
  "version": "1.1.0",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save to gitmarks"
  },
  "icons": {
    "128": "icon.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["activeTab", "contextMenus", "storage"],
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["x.js"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Save this page"
    }
  },
  "optional_host_permissions": ["https://*/*", "http://localhost/*"]
}
