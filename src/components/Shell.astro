---
import "@fontsource-variable/bricolage-grotesque";
import "../styles/global.css";

interface Props {
  title: string;
  /** Only the hosted landing page is public. Everything else is someone's bookmarks. */
  index?: boolean;
}
const { title, index = false } = Astro.props;
const description =
  "Private, categorised bookmarks that live in your own GitHub repo. Save from X, your phone or any browser. Free and open source.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    {index ? (
      <>
        <meta name="description" content={description} />
        <meta property="og:title" content="gitmarks" />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={new URL("/og.jpg", Astro.url).href} />
        <meta name="twitter:card" content="summary_large_image" />
      </>
    ) : (
      // Private: never indexed, never cached, and outbound requests carry no referrer.
      <meta name="robots" content="noindex, nofollow, noarchive" />
    )}
    <meta name="referrer" content="no-referrer" />
    <meta name="theme-color" content="#fdfbf7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#151515" media="(prefers-color-scheme: dark)" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icon-192.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <title>{title}</title>
    <script is:inline>
      // Before first paint, so the page never flashes the wrong theme.
      document.documentElement.classList.toggle("dark", matchMedia("(prefers-color-scheme: dark)").matches);
    </script>
  </head>
  <body class="bg-surface text-ink">
    <slot />
  </body>
</html>
